# ==========================================
# IntrovertIRL RP - Environment Variables
# ==========================================

# Discord OAuth2 Client ID (Used for client-side Whitelist authentication)
NEXT_PUBLIC_DISCORD_CLIENT_ID="your_discord_client_id_here"
CLIENT_ID="your_discord_client_id_here"

# Discord Bot Token (Used by staff bot to review and process whitelist applications)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Discord Channel ID for Staff Whitelist Application Logs
LOG_CHANNEL_ID="your_discord_log_channel_id_here"
